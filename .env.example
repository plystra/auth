PLYSTRA_AUTH_HTTP_ADDR=:8080
PLYSTRA_AUTH_SERVER_ADDR=:8081
PLYSTRA_AUTH_OPS_ADDR=127.0.0.1:8082
PLYSTRA_AUTH_DATABASE_URL=postgres://plystra_auth_app:change-me@localhost:5432/plystra_auth?sslmode=disable
# Owner-role URL used only by `plystra-auth migrate`; the service uses the application-role URL above.
PLYSTRA_AUTH_MIGRATION_DATABASE_URL=postgres://plystra_auth_owner:change-me@localhost:5432/plystra_auth?sslmode=disable
PLYSTRA_AUTH_ISSUER=http://localhost:8080
# At least one active HMAC key. Rotate by versioning comma-separated key values.
PLYSTRA_AUTH_SESSION_HMAC_KEYS=replace-with-at-least-32-random-characters
# Base64 encoded 32-byte key used for encrypting stored factors and recovery material.
PLYSTRA_AUTH_DATA_KEY=base64-32-byte-key
# Base64 encoded 32-byte key for the encrypted signing-key PEM and database records.
PLYSTRA_AUTH_SIGNING_KEY_ENCRYPTION_KEY=base64-32-byte-signing-key-encryption-key
# Encrypted ES256 bootstrap key file. Required in production; empty uses an ephemeral key in development.
PLYSTRA_AUTH_SIGNING_KEY_FILE=
# Maximum Agent delegation depth. The documented default is 8; deployments may use 1-64.
PLYSTRA_AUTH_AGENT_DELEGATION_MAX_DEPTH=8
# SMTP delivery uses mandatory STARTTLS. Required in production for verification and recovery mail.
PLYSTRA_AUTH_SMTP_HOST=
PLYSTRA_AUTH_SMTP_PORT=587
PLYSTRA_AUTH_SMTP_FROM=
PLYSTRA_AUTH_SMTP_USERNAME=
PLYSTRA_AUTH_SMTP_PASSWORD=
