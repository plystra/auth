PLYSTRA_AUTH_HTTP_ADDR=:8080
PLYSTRA_AUTH_SERVER_ADDR=:8081
PLYSTRA_AUTH_OPS_ADDR=127.0.0.1:8082
PLYSTRA_AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/plystra_auth?sslmode=disable
PLYSTRA_AUTH_ISSUER=http://localhost:8080
# At least one active HMAC key. Rotate by versioning comma-separated key values.
PLYSTRA_AUTH_SESSION_HMAC_KEYS=replace-with-at-least-32-random-characters
# Base64 encoded 32-byte key used for encrypting stored factors and recovery material.
PLYSTRA_AUTH_DATA_KEY=base64-32-byte-key
# Optional PEM file containing the ES256 signing key. If empty, serve refuses to start.
PLYSTRA_AUTH_SIGNING_KEY_FILE=
